# Copy to .env and fill in. Never commit the real file.
RUNPOD_API_KEY=
TYPESAFE_API_KEY=

# --- Village scenario (protect the Server) -----------------------------------
# SCENARIO=village gives the clankers the Server-defense game. flag-setup.mjs
# must have run once (pod-bootstrap.sh does it) so village.json exists.
#SCENARIO=survival

# The Server boots one new villager per FLAG_WATER_TARGET coolant buckets.
# A creeper boom near the core makes it overheat and lose coolant.
#FLAG_WATER_TARGET=10
#FLAG_EXPLOSION_PENALTY=3
#MAX_POPULATION=8
#COUNCIL_INTERVAL_MS=600000

# --- Per-clanker LLM routing ---------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint can drive any clanker.
# Unlisted clankers use DEFAULT_LLM_PROVIDER (kimi by default). Missing or
# misconfigured providers produce labeled errors — never a silent switch.
#CLANKER_MODELS=Cinder=deepseek,Vex=openrouter,Mira=kimi
#DEFAULT_LLM_PROVIDER=kimi
#LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
#LLM_DEEPSEEK_API_KEY=
#LLM_DEEPSEEK_MODEL=deepseek-chat
#LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#LLM_OPENROUTER_API_KEY=
#LLM_OPENROUTER_MODEL=

# --- Guest creeper turns --------------------------------------------------------
# Every GUEST_TURN_EVERY_MS the queue's head becomes a creeper at the gate.
# The hard turn cap defaults to the cadence so a new creeper can start on
# schedule even after a full-length turn.
#GUEST_TURN_EVERY_MS=180000
#GUEST_TURN_MAX_MS=180000
#GUEST_MAX_QUEUE=20
#GUEST_INPUT_STALE_MS=2500
#GUEST_IDLE_END_MS=45000
